{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "enabled",
  "commitMessageAction": "aktualisiere",
  "commitMessageExtra": "auf {{newVersion}}",
  "prBodyTemplate": "{{#each upgrades}}- `{{depName}}` von `{{currentValue}}` auf `{{newValue}}` aktualisieren.\n{{/each}}",
  "packageRules": [
    {
      "description": "Stabile Minor- und Patch-Updates nach erfolgreichen Prüfungen mergen",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true,
      "groupName": "kompatible Abhängigkeiten"
    },
    {
      "description": "Action-Digests nach erfolgreichen Prüfungen aktualisieren",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "automerge": true,
      "groupName": "GitHub Actions"
    },
    {
      "description": "Major- und instabile 0.x-Updates bewusst manuell prüfen",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"]
  }
}
